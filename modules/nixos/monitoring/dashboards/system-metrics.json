          "expr": "100 * sum by (mode) (rate(node_cpu_seconds_total{host=~\"$host\", mode!=\"idle\"}[$__rate_interval])) / scalar(count(node_cpu_seconds_total{host=~\"$host\", mode=\"idle\"}))",
