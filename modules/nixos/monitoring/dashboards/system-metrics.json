{
  "uid": "system-metrics",
  "title": "System metrics",
  "tags": [
    "metrics",
    "node",
    "prometheus"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(node_uname_info, host)",
          "refId": "host"
        },
        "definition": "label_values(node_uname_info, host)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Systems",
      "description": "One row per host. Last seen = seconds since the host last pushed metrics.",
      "targets": [
        {
          "expr": "time() - max by (host) (max_over_time(timestamp(node_uname_info{host=~\"$host\"})[24h:1m]))",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "Last seen",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "100 * (1 - avg by (host) (rate(node_cpu_seconds_total{host=~\"$host\", mode=\"idle\"}[2m])))",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "CPU",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B"
        },
        {
          "expr": "100 * (1 - max by (host) (node_memory_MemAvailable_bytes{host=~\"$host\"}) / max by (host) (node_memory_MemTotal_bytes{host=~\"$host\"}))",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "Memory",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C"
        },
        {
          "expr": "100 * (1 - max by (host) (node_filesystem_avail_bytes{host=~\"$host\", mountpoint=\"/\"}) / max by (host) (node_filesystem_size_bytes{host=~\"$host\", mountpoint=\"/\"}))",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "Disk /",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D"
        },
        {
          "expr": "sum by (host) (rate(node_network_receive_bytes_total{host=~\"$host\", device!~\"wg.*|nb-.*|wt.*|tun.*|mullvad.*|tailscale.*\"}[2m]))",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "Net ↓",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "E"
        },
        {
          "expr": "sum by (host) (rate(node_network_transmit_bytes_total{host=~\"$host\", device!~\"wg.*|nb-.*|wt.*|tun.*|mullvad.*|tailscale.*\"}[2m]))",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "Net ↑",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "F"
        },
        {
          "expr": "max by (host) (node_load1{host=~\"$host\"})",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "Load (1m)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "G"
        },
        {
          "expr": "count by (host) (node_cpu_seconds_total{host=~\"$host\", mode=\"idle\"})",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "Cores",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "H"
        },
        {
          "expr": "max by (host) (node_hwmon_temp_celsius{host=~\"$host\"})",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "Temp",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "I"
        },
        {
          "expr": "max by (host) (time() - node_boot_time_seconds{host=~\"$host\"})",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "Uptime",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "J"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Last seen",
              "Value #B": "CPU",
              "Value #C": "Memory",
              "Value #D": "Disk /",
              "Value #E": "Net ↓",
              "Value #F": "Net ↑",
              "Value #G": "Load (1m)",
              "Value #H": "Cores",
              "Value #I": "Temp",
              "Value #J": "Uptime",
              "host": "Host"
